# Copy to .env only if the key is not already in your environment.
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai
# Optional, if your Portkey workspace requires a virtual key:
PORTKEY_VIRTUAL_KEY=
# Optional private local-operator access code (32+ characters).
# If empty, startup generates one in ignored data/operator_access.json.
CAMPUS_OPERATOR_KEY=
